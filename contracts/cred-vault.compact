pragma language_version >= 0.23;

import CompactStandardLibrary;

// ============================================================
// PUBLIC LEDGER STATE — visible on the Midnight blockchain
// ============================================================
export ledger credentials: Map<Bytes<32>, Boolean>;
export ledger credentialCount: Counter;
export ledger issuers: Map<Bytes<32>, Boolean>;

// ============================================================
// PRIVATE WITNESS DECLARATIONS — resolved locally, never on-chain
// ============================================================
witness credentialType(): Bytes<32>;
witness holderSecret(): Bytes<32>;
witness issuerId(): Bytes<32>;
witness salt(): Bytes<32>;

struct CredentialData {
    credType: Bytes<32>,
    holderCommitment: Bytes<32>,
    issuerId: Bytes<32>
}

export circuit registerIssuer(issuerPublicKey: Bytes<32>): [] {
    assert(!issuers.member(disclose(issuerPublicKey)), "Issuer already registered");
    issuers.insert(disclose(issuerPublicKey), true);
}

export circuit issueCredential(holderCommitment: Bytes<32>, issuer: Bytes<32>): [] {
    const credType = credentialType();
    const s = salt();

    assert(issuers.member(disclose(issuer)), "Issuer is not registered");

    const credData = CredentialData {
        credType: credType,
        holderCommitment: holderCommitment,
        issuerId: issuer
    };

    const commitment = persistentCommit<CredentialData>(credData, s);

    assert(!credentials.member(commitment), "Credential already exists");

    credentials.insert(disclose(commitment), true);
    credentialCount.increment(1);
}

export circuit verifyCredential(): [] {
    const credType = credentialType();
    const secret = holderSecret();
    const iId = issuerId();
    const s = salt();

    const computedHolderCommitment = persistentHash<Bytes<32>>(secret);

    const credData = CredentialData {
        credType: credType,
        holderCommitment: computedHolderCommitment,
        issuerId: iId
    };

    const commitment = persistentCommit<CredentialData>(credData, s);

    assert(credentials.member(commitment), "Credential does not exist");
    assert(credentials.lookup(commitment), "Credential has been revoked");
}

export circuit revokeCredential(holderCommitment: Bytes<32>, issuer: Bytes<32>): [] {
    const credType = credentialType();
    const s = salt();

    const credData = CredentialData {
        credType: credType,
        holderCommitment: holderCommitment,
        issuerId: issuer
    };

    const commitment = persistentCommit<CredentialData>(credData, s);

    assert(credentials.member(commitment), "Credential does not exist");
    assert(credentials.lookup(commitment), "Credential already revoked");

    credentials.insert(disclose(commitment), disclose(false));
}
